@model CalendarViewModel
@{
    ViewData["Title"] = "Foglalás naptár";
    var currentMonth = Model.CurrentMonth;
    var bookings = Model.Bookings;
    var firstDayOfMonth = new DateTime(currentMonth.Year, currentMonth.Month, 1);
    var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);
    var firstDayOfCalendar = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek + 1);
    var lastDayOfCalendar = firstDayOfCalendar.AddDays(41);
    
    var today = DateTime.Today;
    var previousMonth = currentMonth.AddMonths(-1);
    var nextMonth = currentMonth.AddMonths(1);
    
    // Group bookings by date for easy lookup
    var bookingsByDate = bookings.GroupBy(b => b.Time.Date).ToDictionary(g => g.Key, g => g.ToList());
    
    // Available time slots (15:00 - 19:00)
    var timeSlots = new[] { 15, 16, 17, 18, 19 };
}

<div class="row">
    <div class="col-md-12">
        <h1 class="mb-4">@ViewData["Title"]</h1>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" asp-route-year="@previousMonth.Year" asp-route-month="@previousMonth.Month" 
                       class="btn btn-outline-light btn-sm">
                        <i class="fas fa-chevron-left"></i> Elõzõ
                    </a>
                    <h4 class="mb-0">@currentMonth.ToString("yyyy. MMMM")</h4>
                    <a asp-action="Index" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month" 
                       class="btn btn-outline-light btn-sm">
                        Következõ <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="calendar-container">
                    <table class="table table-bordered mb-0 calendar-table">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center py-3">Hétfõ</th>
                                <th class="text-center py-3">Kedd</th>
                                <th class="text-center py-3">Szerda</th>
                                <th class="text-center py-3">Csütörtök</th>
                                <th class="text-center py-3">Péntek</th>
                                <th class="text-center py-3">Szombat</th>
                                <th class="text-center py-3">Vasárnap</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var week = 0; week < 6; week++)
                            {
                                <tr>
                                    @for (var day = 0; day < 7; day++)
                                    {
                                        var currentDay = firstDayOfCalendar.AddDays(week * 7 + day);
                                        var isCurrentMonth = currentDay.Month == currentMonth.Month;
                                        var isToday = currentDay.Date == today;
                                        var isPast = currentDay.Date < today;
                                        var isWeekend = currentDay.DayOfWeek == DayOfWeek.Saturday || currentDay.DayOfWeek == DayOfWeek.Sunday;
                                        var isWeekday = !isWeekend;
                                        
                                        var cellClass = "calendar-day";
                                        if (!isCurrentMonth) cellClass += " other-month";
                                        if (isToday) cellClass += " today";
                                        if (isPast && isCurrentMonth && isWeekday) cellClass += " past";
                                        if (isCurrentMonth && !isPast && !isToday && isWeekday) cellClass += " available";
                                        if (isWeekend) cellClass += " weekend";

                                        // Get bookings for this day
                                        var dayBookings = bookingsByDate.ContainsKey(currentDay.Date) 
                                            ? bookingsByDate[currentDay.Date] 
                                            : new List<Booking>();

                                        <td class="@cellClass" data-date="@currentDay.ToString("yyyy-MM-dd")">
                                            <div class="day-content">
                                                <div class="day-number">@currentDay.Day</div>
                                                @if (isToday)
                                                {
                                                    <div class="day-indicator">
                                                        <small class="today-text">Ma</small>
                                                    </div>
                                                }
                                                
                                                @if (isCurrentMonth && isWeekday)
                                                {
                                                    <div class="time-slots">
                                                        @foreach (var hour in timeSlots)
                                                        {
                                                            var slotBooking = dayBookings.FirstOrDefault(b => b.Time.Hour == hour);
                                                            var slotClass = "time-slot";
                                                            
                                                            if (slotBooking != null)
                                                            {
                                                                slotClass += slotBooking.Status switch
                                                                {
                                                                    BookingStatus.Pending => " slot-pending",
                                                                    BookingStatus.Confirmed => " slot-confirmed",
                                                                    BookingStatus.Cancelled => " slot-cancelled",
                                                                    _ => " slot-empty"
                                                                };
                                                            }
                                                            else
                                                            {
                                                                slotClass += " slot-empty";
                                                            }

                                                            <div class="@slotClass" 
                                                                 title="@hour:00 @(slotBooking?.Status?.ToString() ?? "Szabad")"
                                                                 data-hour="@hour" 
                                                                 data-date="@currentDay.ToString("yyyy-MM-dd")">
                                                                <small>@hour</small>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <div class="row text-center">
                    <div class="col-md-2">
                        <div class="legend-item">
                            <span class="legend-color today-legend"></span>
                            <small>Mai nap</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="legend-item">
                            <span class="legend-color available-legend"></span>
                            <small>Szabad</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="legend-item">
                            <span class="legend-color pending-legend"></span>
                            <small>Pending</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="legend-item">
                            <span class="legend-color confirmed-legend"></span>
                            <small>Confirmed</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="legend-item">
                            <span class="legend-color cancelled-legend"></span>
                            <small>Cancelled</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="legend-item">
                            <span class="legend-color weekend-legend"></span>
                            <small>Hétvége</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <div class="alert alert-info">
                <h5><i class="fas fa-info-circle"></i> Tudnivalók</h5>
                <p class="mb-2"><strong>Foglalható órák:</strong> Hétfõ-Péntek: 15:00-19:00</p>
                <p class="mb-2"><strong>Idõtartam:</strong> 30 vagy 60 perces kezelések</p>
                <p class="mb-0"><strong>Színkódok:</strong> Sárga = Pending, Zöld = Confirmed, Szürke = Cancelled</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Calendar slot click handler
        document.addEventListener('DOMContentLoaded', function() {
            const timeSlots = document.querySelectorAll('.time-slot.slot-empty');
            
            timeSlots.forEach(slot => {
                slot.addEventListener('click', function() {
                    const date = this.getAttribute('data-date');
                    const hour = this.getAttribute('data-hour');
                    console.log('Selected slot:', date, hour + ':00');
                    // TODO: Navigate to booking creation for selected date and time
                    // window.location.href = '@Url.Action("Create")' + '?date=' + date + '&hour=' + hour;
                });
                
                slot.style.cursor = 'pointer';
            });
        });
    </script>
    
    <style>
        .calendar-container {
            overflow-x: auto;
        }
        
        .calendar-table {
            min-width: 700px;
        }
        
        .calendar-day {
            height: 160px;
            vertical-align: top;
            padding: 4px;
            position: relative;
            border: 1px solid #dee2e6;
        }
        
        .day-content {
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        
        .day-number {
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 2px;
            text-align: center;
        }
        
        .day-indicator {
            text-align: center;
            margin-bottom: 2px;
        }
        
        .time-slots {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        
        .time-slot {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 3px;
            font-size: 11px;
            min-height: 22px;
            padding: 2px;
        }
        
        .time-slot small {
            font-size: 10px;
            font-weight: bold;
        }
        
        .slot-empty {
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            color: #6c757d;
        }
        
        .slot-empty:hover {
            background-color: #e9ecef;
            cursor: pointer;
        }
        
        .slot-pending {
            background-color: #ffc107;
            border: 1px solid #ff9800;
            color: #212529;
        }
        
        .slot-confirmed {
            background-color: #28a745;
            border: 1px solid #1e7e34;
            color: #ffffff;
        }
        
        .slot-cancelled {
            background-color: #d6d6d6;
            border: 1px solid #999999;
            color: #495057;
            text-decoration: line-through;
        }
        
        .calendar-day.today {
            background-color: #1976d2 !important;
            border-color: #0d47a1 !important;
            color: white !important;
        }
        
        .calendar-day.today .day-number {
            color: white !important;
            font-weight: bold;
        }
        
        .today-text {
            color: white !important;
            font-weight: bold;
            font-size: 0.7rem;
        }
        
        .calendar-day.past {
            background-color: #e0e0e0;
            color: #757575;
        }
        
        .calendar-day.available {
            background-color: #e8f5e8;
            color: #2e7d32;
        }
        
        .calendar-day.other-month {
            background-color: #fafafa;
            color: #ccc;
        }
        
        .calendar-day.weekend {
            background-color: #fff3e0;
        }
        
        .calendar-day.weekend .day-number {
            color: #f57c00;
        }
        
        .legend-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex-direction: column;
        }
        
        .legend-color {
            width: 20px;
            height: 12px;
            border-radius: 2px;
            border: 1px solid #dee2e6;
        }
        
        .today-legend {
            background-color: #1976d2;
            border-color: #0d47a1;
        }
        
        .available-legend {
            background-color: #f8f9fa;
            border-color: #e9ecef;
        }
        
        .pending-legend {
            background-color: #ffc107;
            border-color: #ff9800;
        }
        
        .confirmed-legend {
            background-color: #28a745;
            border-color: #1e7e34;
        }
        
        .cancelled-legend {
            background-color: #d6d6d6;
            border-color: #999999;
        }
        
        .weekend-legend {
            background-color: #fff3e0;
        }
    </style>
}